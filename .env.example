# Copie este arquivo para .env e preencha os valores.
#
# Valores PÚBLICOS (podem ficar no repositório e vão para o navegador).
# A chave "publishable"/anon do Supabase é protegida pelas políticas de RLS.
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""

VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# ---------------------------------------------------------------------------
# Valores SECRETOS — NUNCA commitar. Em produção use os secrets do Cloudflare
# (wrangler secret put NOME) e, em desenvolvimento, um arquivo .dev.vars
# (já ignorado pelo Git).
# ---------------------------------------------------------------------------

# Origem pública da aplicação, usada para montar as URLs de retorno do checkout.
# Ex.: https://seudominio.com.br
# APP_ORIGIN=""

# Supabase com privilégios de administrador (usado em admin.server.ts e no
# webhook do Mercado Pago). Ignora RLS — trate como senha mestra.
# SYSTEM_SUPABASE_URL=""
# SYSTEM_SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_SERVICE_ROLE_KEY=""

# Mercado Pago: access token da aplicação e chave secreta do webhook.
# MERCADO_PAGO_ACCESS_TOKEN=""
# MP_WEBHOOK_SECRET=""
